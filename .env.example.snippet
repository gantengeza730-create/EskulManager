# Tambahkan/ubah baris berikut pada file .env Laravel Anda
APP_NAME="Ekskul SMK"
APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta
DB_CONNECTION=sqlite          # mudah untuk belajar. Untuk MySQL: DB_CONNECTION=mysql lalu isi DB_DATABASE dst.
MAIL_MAILER=log               # kode verifikasi akan tercatat di storage/logs/laravel.log
